<div class="form-card">
  <%= form_with model: [:admin, order], local: true, class: "custom-form" do |f| %>
    <% if order.errors.any? %>
      <div class="error-box">
        <h4><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h4>

        <ul>
          <% order.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :customer_name %>
      <%= f.text_field :customer_name, class: "form-input", placeholder: "Enter customer name" %>
    </div>

    <div class="form-group">
      <%= f.label :customer_email %>
      <%= f.email_field :customer_email, class: "form-input", placeholder: "Enter customer email" %>
    </div>

     <div class="form-group">
      <%= f.label :order_items, "Books" %>

      <div class="order-items" id="order-items">
        <%= f.fields_for :order_items do |item_form| %>
          <%= render "order_item_fields", item_form: item_form %>
        <% end %>
      </div>

      <button type="button" class="btn-secondary" id="add-order-item">
        ＋ Add Item
      </button>

      <template id="order-item-template">
        <%= f.fields_for :order_items, OrderItem.new, child_index: "NEW_RECORD" do |item_form| %>
          <%= render "order_item_fields", item_form: item_form %>
        <% end %>
      </template>
    </div>

    <div class="form-group">
      <%= f.label :status %>
      <%= f.select :status,
          [["Pending", "pending"], ["Paid", "paid"], ["Shipped", "shipped"], ["Cancelled", "cancelled"]],
          { prompt: "Select status" },
          class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", admin_orders_path, class: "btn-secondary" %>
      <%= f.submit order.new_record? ? "Create Order" : "Update Order", class: "btn-primary" %>
    </div>
  <% end %>
</div>