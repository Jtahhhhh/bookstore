<div class="page-header">
  <div>
    <h1 class="page-title">Categories</h1>
    <p class="page-subtitle">Manage all categories in your store</p>
  </div>

  <%= link_to "＋ New Category", new_admin_category_path, class: "btn-primary" %>
</div>

<div class="grid">
  <% @categories.each do |category| %>
    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="name"><%= category.name %></h3>
        </div>
      </div>

      <% if category.respond_to?(:slug) && category.slug.present? %>
        <p class="bio">
          <%= truncate(category.slug, length: 120) %>
        </p>
      <% end %>

      <div class="actions">
        <%= link_to "View", admin_category_path(category), class: "btn-secondary" %>
        <%= link_to "Edit", edit_admin_category_path(category), class: "btn-warning" %>

        <%= link_to "Delete",
            admin_category_path(category),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure?"
            },
            class: "btn-danger" %>
      </div>
    </div>
  <% end %>
</div>