<div class="form-page">
  <div class="form-card">

    <%= form_with model: [:admin, @book], local: true, class: "custom-form" do |f| %>

      <% if @book .errors.any? %>
        <div class="error-box">
          <h4>
            <%= pluralize(@book.errors.count, "error") %> prohibited this book  from being saved:
          </h4>

          <ul>
            <% @book .errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h3 class="name"><%= @book.title %></h3>

      <p class="bio"><%= @book.description%></p>
      <p class="author"><strong>Author:</strong> <%= @book.author.name %></p>
      <p class="categories"><strong>Categories:</strong> <%= @book.categories.map(&:name).join(", ") %></p>
      <p class="price"><strong>Price:</strong> $<%= @book.price %></p>
      <p class="stock"><strong>Stock:</strong> <%= @book.stock %> copies</p>
      <p class="published"><strong>Published:</strong> <%= @book.published ? "Yes" : "No" %></p>

      <div class="actions">
        <%= link_to "Edit", edit_admin_book_path(@book), class: "btn-warning" %>

        <%= link_to "Delete",
            admin_book_path(@book),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure?"
            },
            class: "btn-danger" %>
      </div>

    <% end %>
  </div>
</div>