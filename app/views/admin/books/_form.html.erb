<div class="form-card">
  <%= form_with model: [:admin, book], local: true, class: "custom-form" do |f| %>
    <% if book.errors.any? %>
      <div class="error-box">
        <h4><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h4>

        <ul>
          <% book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, class: "form-input", placeholder: "Enter book title" %>
    </div>

    <div class="form-group">
      <%= f.label :author_id, "Author" %>
      <%= f.collection_select :author_id,
          Author.order(:name),
          :id,
          :name,
          { prompt: "Select author" },
          { class: "form-input" } %>
    </div>

    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_area :description,
          rows: 5,
          class: "form-input",
          placeholder: "Write book description..." %>
    </div>

    <div class="form-group">
      <%= f.label :price %>
      <%= f.text_field :price, class: "form-input", placeholder: "Enter book price" %>
    </div>

    <div class="form-group">
      <%= f.label :stock %>
      <%= f.text_field :stock, class: "form-input", placeholder: "Enter book stock" %>
    </div>

    <div class="form-group">
      <%= f.label :published, class: "switch-label" %>

      <label class="switch">
        <%= f.check_box :published, class: "switch-input" %>
        <span class="slider"></span>
      </label>
    </div>
    

    <div class="form-group">
      <%= f.label :category_ids, "Categories" %>

      <div class="checkbox-list">
        <%= f.collection_check_boxes :category_ids, categories.order(:name), :id, :name do |b| %>
          <label class="checkbox-item">
            <%= b.check_box %>
            <span><%= b.text %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", admin_books_path, class: "btn-secondary" %>
      <%= f.submit @book.new_record? ? "Create Book" : "Update Book", class: "btn-primary" %>
    </div>
  <% end %>
</div>